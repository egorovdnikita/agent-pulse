{
  "manifest_version": 3,
  "name": "Agent Pulse",
  "version": "0.1.0",
  "description": "Показывает маскоту Agent Pulse, когда Claude в браузере думает, ждёт одобрения или закончил.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://claude.ai/*", "https://www.figma.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://claude.ai/*"], "js": ["content.js"], "run_at": "document_idle" },
    { "matches": ["https://www.figma.com/make/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
